# Dependencias y artefactos de compilación (evita repositorios pesados)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
coverage/
.vite/
frontend/.vite/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Entornos virtuales y caché de Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Variables de entorno y secretos (seguridad y privacidad)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets/
credentials.json

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
